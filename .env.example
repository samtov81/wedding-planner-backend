# Entorno del backend. Cada variable la valida `src/config/env.schema.ts` al
# arrancar: si falta o está mal, el proceso no arranca y dice cuál. Este
# fichero lista TODAS (un test lo comprueba) y, tal cual, sirve para local con
# `docker compose up -d`. `KEY=` vacío en una opcional = sin configurar.

NODE_ENV=development
PORT=3000

# Postgres y Redis del docker-compose.yml.
DATABASE_URL=postgresql://wp:wp@localhost:5432/wedding_planner
REDIS_URL=redis://localhost:6379

# Firma de los access tokens (HS256): 32 caracteres como mínimo. En producción
# el arranque rechaza este valor de ejemplo.
JWT_ACCESS_SECRET=cambia-esto-por-32-caracteres-o-mas
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Horas de validez de un token de verificación de email (defecto 48).
EMAIL_VERIFICATION_TTL_HOURS=48

# Correo. `fake` no envía nada (guarda los correos en memoria; sólo local y
# test); `resend` los envía de verdad y exige RESEND_WEBHOOK_SECRET
# (whsec_<base64>, del panel de webhooks de Resend) y RESEND_API_KEY. Con
# NODE_ENV=production el arranque exige `resend` y un MAIL_FROM real (no .test).
MAIL_DRIVER=fake
MAIL_FROM=no-reply@weddingplanner.test
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Origen del frontend: base de los enlaces del RSVP y, siempre, parte de la
# allowlist de CORS (HTTP y Socket.IO).
APP_URL=http://localhost:5173
# Orígenes ADICIONALES, separados por comas: esquema://host[:puerto], sin ruta
# ni barra final. Nunca `*`.
CORS_ORIGINS=

# De dónde sale la IP del cliente (la clave de los límites de ritmo). Vacío o
# `false` sin proxy delante; `1` detrás de UN balanceador; o las IPs/subredes de
# los proxies. `true` se rechaza: dejaría a cualquiera falsear su IP.
TRUST_PROXY=

# fatal | error | warn | info | debug | trace | silent. Vacío: `info` (`silent` en test).
LOG_LEVEL=

# GET /docs y GET /openapi.json. Vacío: encendido salvo en producción, donde se
# apaga por defecto. `true`/`false` para fijarlo explícitamente.
DOCS_ENABLED=
