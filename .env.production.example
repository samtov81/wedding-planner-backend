# Copy to .env.production on the server (or inject these as real env vars).
# Loaded automatically when NODE_ENV=production.
#
# Startup FAILS in production if any of these is wrong:
#   - JWT_ACCESS_SECRET shorter than 32 chars or left as a placeholder
#   - COOKIE_SECURE not true
#   - APP_URL not https
#   - CORS_ORIGIN containing "*" or an http:// origin
#   - SENDGRID_API_KEY missing while EMAIL_PROVIDER=sendgrid

# App
PORT=3000
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com
LOG_LEVEL=info
# Number of reverse proxies in front of the app (nginx/Cloudflare = 1).
# Wrong values let clients spoof req.ip and bypass rate limiting.
TRUST_PROXY=1

# Database
DATABASE_URL=postgresql://user:password@db-host:5432/backend_base?schema=public&sslmode=require

# Redis
REDIS_URL=rediss://user:password@redis-host:6380

# Auth / JWT - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=backend-base
JWT_AUDIENCE=backend-base-api
# Only set COOKIE_DOMAIN if the API and frontend share a parent domain
# (e.g. .example.com). Empty = host-only cookie, the safer default.
COOKIE_DOMAIN=
COOKIE_SECURE=true

# Storage provider (Cloudflare R2, S3-compatible)
STORAGE_PROVIDER=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Email provider
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@example.com

# Push provider
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
